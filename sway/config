# Sway Configuration - Mimicking your Hyprland setup
# This is a 1:1 translation of your keybinds, rules, and autostarts.

set $mod Mod4

# Gaps and Borders
# In Sway, spacing between windows = inner (10px), and spacing at outer edges = inner + outer (10px + 0px = 10px).
gaps inner 10
gaps outer 0
default_border pixel 1
hide_edge_borders --i3 smart

# SwayFX specific features (Blur)
blur enable
blur_passes 3
blur_radius 8

# Window Colors — set dynamically by apply-theme-colors.sh from the active theme.
# These are fallback defaults (overridden at startup by exec_always below).
client.focused          #FF8C00 #54382B #ffffff #FF8C00 #FF8C00
client.unfocused        #66483933 #54382B #ffffff #66483933 #66483933

# Input
input * {
    xkb_layout "de"
}

input type:touchpad {
    tap enabled
    tap_button_map lrm
    natural_scroll disabled
    dwt enabled
}

# Autostart (Running your exact Hyprland scripts)
# Note: rustbar may or may not work depending on what Wayland APIs it uses.
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK DISPLAY XAUTHORITY
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP DBUS_SESSION_BUS_ADDRESS DISPLAY XAUTHORITY SWAYSOCK
exec command -v uwsm >/dev/null && uwsm finalize SWAYSOCK
exec ~/.config/hypr/scripts/change_wallpaper.sh init
exec ~/.config/hypr/scripts/target/release/rustbar
exec ~/.config/hypr/scripts/target/release/control-center --daemon
exec autotiling-rs
exec_always ~/.config/sway/scripts/apply-theme-colors.sh

# Floating Rules
for_window [class="^control-center$"] floating enable

# Core Keybindings
bindsym $mod+Return exec kitty
bindsym $mod+q kill
bindsym $mod+space exec rofi -show drun
bindsym $mod+m exec ~/.config/hypr/scripts/power-menu.sh
bindsym $mod+f fullscreen toggle
bindsym $mod+v floating toggle
bindsym $mod+l exec "hyprlock || loginctl lock-session"

# Focus Navigation
bindsym $mod+h focus left
bindsym $mod+k focus up
bindsym $mod+j focus down
# (Note: In your hyprland config, $mod+L was lock, so focus right was unbound)

# Alt+Tab equivalent
bindsym Mod1+Tab focus next
bindsym Mod1+Shift+Tab focus prev

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5

bindsym $mod+Right workspace next
bindsym $mod+Left workspace prev
bindsym $mod+Shift+Right move container to workspace next
bindsym $mod+Shift+Left move container to workspace prev

# Custom Scripts Keybindings
bindsym $mod+Mod1+d exec ~/.config/hypr/scripts/toggle-laptop-screen.sh
bindsym $mod+c exec ~/.config/hypr/scripts/target/release/control-center
bindsym $mod+Mod1+k exec ~/.config/hypr/scripts/toggle-keyd.sh
bindsym $mod+t exec ~/.config/hypr/scripts/theme-switcher.sh
bindsym $mod+b exec python3 -c "import socket,os; socket.socket(socket.AF_UNIX).connect(f'/tmp/rustbar-{os.getuid()}.sock')"
bindsym $mod+w exec ~/.config/hypr/scripts/change_wallpaper.sh next
bindsym $mod+Shift+w exec ~/.config/hypr/scripts/change_wallpaper.sh prev

# Screenshots 
# Note: hyprshot explicitly looks for hyprland. You will likely need to install 'grim' and 'slurp' and change this script for Sway.
bindsym Print exec hyprshot -m region
bindsym $mod+Print exec hyprshot -m window
bindsym $mod+Shift+Print exec hyprshot -m output

# Media & Volume
bindsym --locked XF86AudioMute exec ~/.config/hypr/scripts/change-volume.sh toggle
bindsym --locked XF86AudioLowerVolume exec ~/.config/hypr/scripts/change-volume.sh lower
bindsym --locked XF86AudioRaiseVolume exec ~/.config/hypr/scripts/change-volume.sh raise
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86MonBrightnessDown exec ~/.config/hypr/scripts/change-brightness.sh -5%
bindsym --locked XF86MonBrightnessUp exec ~/.config/hypr/scripts/change-brightness.sh +5%
