/* Rofi Power Menu Theme - Brutalist CLI Style */

configuration {
    click-to-exit: true;
}

@import "../theme/generated/colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 24";
    background-color: transparent;
    text-color:       @fg-primary;
}

window {
    background-color: @bg-base;
    border:           2px;
    border-color:     @border;
    border-radius:    0px;
    width:            360px;
    padding:          20px;
    location:         center;
    anchor:           center;
}

mainbox {
    children:         [ listview ];
    spacing:          0px;
    padding:          0px;
}

listview {
    fixed-height:     false;
    fixed-columns:    true;
    columns:          3;
    lines:            1;
    spacing:          16px;
    scrollbar:        false;
    padding:          0px;
}

element {
    children:         [ element-text ];
    width:            90px;
    padding:          14px 0px;
    margin:           0px;
    border:           2px;
    border-color:     @border;
    border-radius:    0px;
    cursor:           pointer;
}

element normal.normal,
element alternate.normal {
    background-color: @bg-input;
    text-color:       @fg-primary;
}

element selected.normal {
    background-color: @accent;
    text-color:       @bg-base;
    border-color:     @accent;
}

element-text {
    font:             "JetBrainsMono Nerd Font 24";
    margin:           0px;
    border:           0px;
    padding:          0px;
    text-color:       inherit;
    vertical-align:   0.5;
    horizontal-align: 0.5;
    cursor:           inherit;
    expand:           true;
}
