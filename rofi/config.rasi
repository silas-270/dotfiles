configuration {
    modi:               "drun,run,window";
    show-icons:         true;
    icon-theme:         "Papirus";
    terminal:           "kitty";
    drun-display-format: "{name}";
    disable-history:    false;
    hide-scrollbar:     true;
    display-drun:       "[ apps ]";
    display-run:        "[ run ]";
    display-window:     "[ windows ]";
    sidebar-mode:       true;
    
    /* Navigation bindings */
    kb-mode-next:       "Control+Tab,Shift+Right";
    kb-mode-previous:   "Control+Shift+Tab,Shift+Left";
    
    /* Close on click outside */
    click-to-exit:      true;
    
    /* Mouse support */
    hover-select:       true;
    me-select-entry:    "";
    me-accept-entry:    "MousePrimary";
}

@import "../theme/generated/colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 12";
    background-color: transparent;
    text-color:       @fg-primary;
}

window {
    background-color: @bg-base;
    border:           2px;
    border-color:     @border;
    border-radius:    0px;
    width:            750px;
    padding:          20px;
}

mainbox {
    spacing:          16px;
    children:         [ inputbar, message, listview, mode-switcher ];
}

inputbar {
    spacing:          12px;
    padding:          10px 14px;
    background-color: @bg-input;
    border:           2px;
    border-color:     @border;
    border-radius:    0px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Bold 13";
    vertical-align:   0.5;
}

entry {
    placeholder:      "Suchen...";
    placeholder-color:@fg-muted;
    vertical-align:   0.5;
    text-color:       @fg-primary;
    background-color: transparent;
    font:             "JetBrainsMono Nerd Font 13";
    cursor:           text;
}

listview {
    fixed-height:     true;
    columns:          2;
    lines:            7; 
    spacing:          8px;
    scrollbar:        false;
    padding:          4px 0px 0px 0px;
}

element {
    padding:          8px 12px;
    border-radius:    0px;
    spacing:          12px;
    background-color: transparent;
    cursor:           pointer;
    border:           0px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg-primary;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @fg-primary;
}

element selected.normal {
    background-color: @accent;
    text-color:       @bg-base;
    border-radius:    0px;
}

element-text {
    text-color:       inherit;
    vertical-align:   0.5;
    highlight:        bold #C47A10; 
    cursor:           inherit;
}

element-icon {
    size:             2.0em;
    vertical-align:   0.5;
    cursor:           inherit;
}

mode-switcher {
    spacing:          12px;
    padding:          8px 0px 0px 0px;
    border:           0px;
}

button {
    padding:          8px 14px;
    background-color: transparent;
    text-color:       @fg-muted;
    border:           2px;
    border-color:     @border;
    border-radius:    0px;
    vertical-align:   0.5;
    horizontal-align: 0.5;
    cursor:           pointer;
    font:             "JetBrainsMono Nerd Font 12";
}

button selected {
    background-color: @accent;
    text-color:       @bg-base;
    border:           2px;
    border-color:     @accent;
    border-radius:    0px;
    font:             "JetBrainsMono Nerd Font Bold 12";
}
