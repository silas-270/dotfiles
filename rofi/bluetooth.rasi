/* Rofi Bluetooth Menu Theme - Brutalist CLI Style */

configuration {
    click-to-exit: true;
}

@import "../theme/generated/colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 12";
    
    border-ui:   transparent;
    border-win:  transparent;
    
    background-color: transparent;
    text-color:       @fg-primary;
}

window {
    background-color: @bg-base;
    border:           2px;
    border-color:     @border;
    border-radius:    0px;
    width:            380px;
    padding:          12px;
}

mainbox {
    spacing:          10px;
    children:         [ inputbar, listview ];
}

inputbar {
    spacing:          8px;
    padding:          6px 8px;
    background-color: @bg-input;
    border:           2px;
    border-color:     @border;
    border-radius:    0px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Bold 12";
    padding:          4px 8px;
    vertical-align:   0.5;
}

entry {
    placeholder:      "search...";
    placeholder-color:@fg-muted;
    vertical-align:   0.5;
    text-color:       @fg-primary;
    background-color: transparent;
    font:             "JetBrainsMono Nerd Font 12";
}

listview {
    fixed-height:     false;
    spacing:          4px;
    scrollbar:        false;
    lines:            12;
}

element {
    padding:          6px 8px;
    border-radius:    0px;
    spacing:          8px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg-primary;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @fg-primary;
}

element selected.normal {
    background-color: @accent;
    text-color:       @bg-base;
}

element-text {
    font:             "JetBrainsMono Nerd Font 12";
    text-color:       inherit;
    vertical-align:   0.5;
}

element-icon {
    size:             1.2em;
    vertical-align:   0.5;
}
