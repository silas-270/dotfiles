{
  "layer": "top",
  "position": "top",
  "margin-top": 10,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left": [
    "custom/logo",
    "hyprland/workspaces"
  ],
  "modules-center": [],
  "modules-right": [
    "network",
    "bluetooth",
    "battery",
    "clock",
    "custom/controlcenter"
  ],

  "custom/logo": {
    "format": "[ arch ]",
    "tooltip": false
  },

  "hyprland/workspaces": {
    "format": "[ {id} ]",
    "on-click": "activate",
    "sort-by-number": true,
    "active-only": false,
    "tooltip": false
  },

  "network": {
    "format-wifi": "[ 󰖩 ]",
    "format-ethernet": "[ 󰈀 ]",
    "format-disconnected": "[ 󰖪 ]",
    "format-disabled": "[ 󰖪 ]",
    "on-click": "~/.config/hypr/scripts/rofi-wifi-menu.sh",
    "tooltip": false
  },

  "bluetooth": {
    "format": "[  ]",
    "format-disabled": "[ 󰂲 ]",
    "format-connected": "[ 󰂱 ]",
    "format-connected-battery": "[ 󰂱 ]",
    "on-click": "~/.config/hypr/scripts/rofi-bluetooth-menu.sh",
    "tooltip": false
  },

  "battery": {
    "format": "[ {icon} {capacity}% ]",
    "format-charging": "[ 󰂄 {capacity}% ]",
    "format-full": "[ 󰁹 {capacity}% ]",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "states": {
      "warning": 30,
      "critical": 15
    },
    "tooltip": false
  },

  "clock": {
    "format": "[ 󰥔 {:%H:%M} ]",
    "format-alt": "[ 󰥔 {:%a %d.%m.%Y} ]",
    "tooltip-format": "<tt>{calendar}</tt>"
  },

  "custom/controlcenter": {
    "format": "[  ]",
    "on-click": "~/.config/hypr/scripts/control-center/target/release/control-center",
    "tooltip": false
  }
}
