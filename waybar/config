{
  "layer": "top",
  "position": "top",
  "margin-top": 10,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left": [
    "custom/logo",
    "hyprland/workspaces",
    "network",
    "bluetooth"
  ],
  "modules-center": [],
  "modules-right": [
    "custom/sound",
    "battery",
    "clock",
    "custom/controlcenter"
  ],

  "custom/logo": {
    "format": "[ arch ]",
    "tooltip": false
  },

  "hyprland/workspaces": {
    "format": "[ {id} ]",
    "on-click": "activate",
    "sort-by-number": true,
    "active-only": false,
    "tooltip": false
  },

  "network": {
    "format-wifi": "[ 󰖩 ]",
    "format-ethernet": "[ 󰈀 ]",
    "format-disconnected": "[ 󰖪 ]",
    "format-disabled": "[ 󰖪 ]",
    "on-click": "~/.config/hypr/scripts/rofi-wifi-menu.sh",
    "tooltip": false
  },

  "bluetooth": {
    "format": "[  ]",
    "format-disabled": "[ 󰂲 ]",
    "format-connected": "[ 󰂱 ]",
    "format-connected-battery": "[ 󰂱 ]",
    "on-click": "~/.config/hypr/scripts/rofi-bluetooth-menu.sh",
    "tooltip": false
  },

  "custom/sound": {
    "exec": "~/.config/hypr/scripts/waybar-sound.sh",
    "interval": 1,
    "on-click": "pavucontrol",
    "on-click-right": "playerctl play-pause",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ && ~/.config/hypr/scripts/waybar-sound.sh",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && ~/.config/hypr/scripts/waybar-sound.sh",
    "tooltip": false
  },

  "battery": {
    "format": "[ {icon} ]",
    "format-alt": "[ {icon} {capacity}% ]",
    "format-icons": {
      "charging": [
        "󰂄"
      ],
      "default": [
        "󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
      ]
    },
    "states": {
      "warning": 30,
      "critical": 15
    },
    "tooltip": false
  },

  "clock": {
    "format": "[ {:%H:%M} ]",
    "format-alt": "[ {:%a %d.%m.%Y} ]",
    "tooltip-format": "<tt>{calendar}</tt>"
  },

  "custom/controlcenter": {
    "format": "[  ]",
    "on-click": "~/.config/hypr/scripts/control-center/target/release/control-center",
    "tooltip": false
  }
}
