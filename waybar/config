{
  "layer": "top",
  "position": "top",
  "margin-top": 10,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left": [
    "hyprland/workspaces",
    "network",
    "bluetooth"
  ],
  "modules-center": [
    "cpu",
    "custom/centerpiece",
    "custom/memory"
  ],
  "modules-right": [
    "custom/volume",
    "battery",
    "clock",
    "custom/controlcenter"
  ],

  "cpu": {
    "format": "[ CPU {usage}% ]",
    "interval": 2,
    "tooltip": false
  },

  "custom/memory": {
    "exec": "~/.config/hypr/scripts/waybar-ram.sh",
    "interval": 2,
    "tooltip": false
  },

  "hyprland/workspaces": {
    "format": "[ {id} ]",
    "on-click": "activate",
    "sort-by-number": true,
    "active-only": false,
    "tooltip": false
  },

  "network": {
    "format-wifi": "[ 󰖩 ]",
    "format-ethernet": "[ 󰈀 ]",
    "format-disconnected": "[ 󰖪 ]",
    "format-disabled": "[ 󰖪 ]",
    "on-click": "~/.config/hypr/scripts/rofi-wifi-menu.sh",
    "tooltip": false
  },

  "bluetooth": {
    "format": "[  ]",
    "format-disabled": "[ 󰂲 ]",
    "format-connected": "[ 󰂱 ]",
    "format-connected-battery": "[ 󰂱 ]",
    "on-click": "~/.config/hypr/scripts/rofi-bluetooth-menu.sh",
    "tooltip": false
  },

  "custom/centerpiece": {
    "exec": "~/.config/hypr/scripts/waybar-centerpiece.sh",
    "interval": 1,
    "on-click": "playerctl status 2>/dev/null | grep -qE 'Playing|Paused' && ~/.config/hypr/scripts/control-center/target/release/control-center",
    "tooltip": false
  },

  "custom/volume": {
    "exec": "~/.config/hypr/scripts/waybar-volume.sh",
    "return-type": "json",
    "on-click": "~/.config/hypr/scripts/control-center/target/release/control-center",
    "tooltip": false
  },

  "battery": {
    "format": "[ {icon} ]",
    "format-charging": "[ 󰂄 ]",
    "format-plugged": "[ 󰂄 ]",
    "format-full": "[ 󰂄 ]",
    "format-alt": "[ {icon} {capacity}% ]",
    "format-icons": {
      "charging": [
        "󰂄"
      ],
      "default": [
        "󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
      ]
    },
    "states": {
      "warning": 30,
      "critical": 15
    },
    "tooltip": false
  },

  "clock": {
    "format": "[ {:%H:%M} ]",
    "format-alt": "[ {:%a %d.%m.%Y} ]",
    "tooltip-format": "<tt>{calendar}</tt>"
  },

  "custom/controlcenter": {
    "format": "[  ]",
    "on-click": "~/.config/hypr/scripts/control-center/target/release/control-center",
    "tooltip": false
  }
}
